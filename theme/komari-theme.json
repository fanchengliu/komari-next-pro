{
  "name": "Komari Liu",
  "short": "komari-liu",
  "description": "A custom Komari theme designed by LIU on top of the official Komari web baseline: soft dashboard visuals, background center, traffic, assets and card enhancements.",
  "version": "0.1.0-dev",
  "author": "LIU / OpenClaw Assistant",
  "url": "https://github.com/fanchengliu/komari-liu",
  "preview": "preview.png",
  "configuration": {
    "name": "Komari Liu 主题设置",
    "icon": "Palette",
    "description": "Komari Liu 自制主题设置",
    "managedFields": [
      {
        "key": "background.mode",
        "type": "option",
        "label": "背景模式",
        "options": [
          "image",
          "video"
        ],
        "default": "image"
      },
      {
        "key": "background.intervalSeconds",
        "type": "number",
        "label": "图片轮换秒数",
        "default": 10
      },
      {
        "key": "background.videoPlayMode",
        "type": "option",
        "label": "视频播放模式",
        "options": [
          "full",
          "fixed"
        ],
        "default": "full"
      }
    ],
    "fields": [
      {
        "type": "title",
        "name": "Komari Liu"
      },
      {
        "key": "background.mode",
        "type": "select",
        "name": {
          "zh-CN": "背景模式",
          "en-US": "Background Mode"
        },
        "default": "image",
        "options": "image,video"
      },
      {
        "key": "background.intervalSeconds",
        "type": "number",
        "name": {
          "zh-CN": "图片轮换秒数",
          "en-US": "Image interval seconds"
        },
        "default": 10
      },
      {
        "key": "background.videoPlayMode",
        "type": "select",
        "name": {
          "zh-CN": "视频播放模式",
