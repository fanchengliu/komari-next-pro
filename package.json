{
  "name": "komari-next-pro",
  "version": "3.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <27"
  },
  "scripts": {
    "dev": "node scripts/prepare-theme-assets.mjs && vite --config apps/theme/vite.config.ts --host 127.0.0.1",
    "build": "node scripts/prepare-theme-assets.mjs && tsc --noEmit && vite build --config apps/theme/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "extension": "tsx apps/extension/src/main.ts",
    "demo": "tsx scripts/demo-server.ts",
    "package": "node scripts/package.mjs",
    "locales": "node scripts/build-locales.mjs",
    "audit:public": "node scripts/audit-public.mjs --packages",
    "verify:source": "node scripts/verify-source.mjs",
    "docs:dev": "node scripts/prepare-docs-assets.mjs && vitepress dev site --host 127.0.0.1 --port 5178",
    "docs:build": "node scripts/prepare-docs-assets.mjs && vitepress build site && node scripts/sync-docs-public.mjs",
    "docs:preview": "vitepress preview site --host 127.0.0.1 --port 5178"
  },
  "dependencies": {
    "@fastify/multipart": "10.1.1",
    "@fastify/static": "10.1.4",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-popover": "1.1.23",
    "@tanstack/react-query": "5.103.1",
    "echarts": "6.1.0",
    "fastify": "5.12.5",
    "flag-icons": "7.5.0",
    "lucide-react": "1.47.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "simple-icons": "16.32.0",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "6.1.1",
    "fflate": "0.8.3",
    "opencc-js": "1.4.2",
    "prettier": "3.9.8",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitepress": "1.6.4",
    "vitest": "5.0.1",
    "ws": "8.21.3"
  },
  "license": "MIT",
  "description": "Komari Next Pro — an independent glass theme and optional companion service",
  "repository": {
    "type": "git",
    "url": "https://github.com/fanchengliu/komari-next-pro.git"
  }
}
